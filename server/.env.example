# Server Port & Environment
PORT=5000
NODE_ENV=development

# Allowed Origins / Frontend URLs (for CORS & redirects)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/stemvault

# Authentication
JWT_SECRET=replace_with_a_secure_random_secret_string

# Payment Gateway (Paystack)
# Use 'sk_test_dummy' for local mock checkout without real Paystack credentials
PAYSTACK_SECRET_KEY=sk_test_dummy

# Media Asset Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Seeding (used by npm run seed:admin)
ADMIN_EMAIL=admin@stemvault.com
ADMIN_PASSWORD=adminpassword123
ADMIN_FULL_NAME=StemVault Admin
